      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (status, reason) (increase(tracklah_trip_transitions_total[$__interval]))",
          "legendFormat": "{{status}} {{reason}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum(increase(tracklah_trips_created_total[$__interval]))",
          "legendFormat": "requested"
