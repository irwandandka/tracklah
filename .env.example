# Absolute path on the HOST machine to the Firebase service account JSON
# key (Firestore Admin SDK). Never commit the actual key file - this only
# points docker-compose at wherever you keep it locally.
FIRESTORE_CREDENTIALS_PATH=/absolute/path/to/your/firebase-adminsdk.json
FIRESTORE_PROJECT_ID=your-firebase-project-id

# Jenkins admin login, provisioned via Configuration-as-Code on first boot
# (see services/jenkins/casc.yaml) - not a real production credential,
# just picks who can log in to the local Jenkins instance.
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=change-me
